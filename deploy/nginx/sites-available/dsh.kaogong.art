map $http_upgrade $dsh_connection_upgrade {
    default upgrade;
    ""      close;
}
# 2026-10-04：门禁 cookie 自动换发 —— 带着合规 dsh_gate 的请求会被重新签发为新属性，
# 用于把存量设备从 SameSite=Strict 平滑迁移到 Lax（设备无需再输一次口令）。
# 键为短正则、值原样回填（均不含 SECRET）；无 cookie 或格式不符时不发送任何 Set-Cookie。
map $cookie_dsh_gate $dsh_gate_refresh {
    default "";
    "~^[a-f0-9]{64}$" "dsh_gate=$cookie_dsh_gate; Max-Age=31536000; Secure; HttpOnly; Path=/; SameSite=Lax";
}
js_path /etc/nginx/njs/;
js_import dshg from dsh_gate.js;
server {
    listen 80;
    listen [::]:80;
    server_name dsh.kaogong.art;
    location ^~ /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name dsh.kaogong.art;
    ssl_certificate /etc/letsencrypt/live/dsh.kaogong.art/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/dsh.kaogong.art/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
    include snippets/dsh-session.conf;
    include snippets/dsh-pwa.conf;
    auth_request /_dsh_gate;
    client_max_body_size 1024m;
    error_page 401 =200 /dsh-login;
    location = /_dsh_gate { internal; auth_request off; js_content dshg.gate; }
    location = /dsh-login {
        auth_request off;
        js_content dshg.login;
        limit_req zone=dsh_login burst=5 nodelay;
        limit_req_status 429;
    }
    location ^~ /.well-known/acme-challenge/ { auth_request off; root /var/www/html; }
    location / {
        add_header Set-Cookie $dsh_gate_refresh;
        proxy_pass http://127.0.0.1:3080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $dsh_connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Cookie "$dsh_inject_cookie; $http_cookie";
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        client_max_body_size 200m;
    }
}
